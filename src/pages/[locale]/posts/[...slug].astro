---
import { getCollection } from 'astro:content'
import LocalizedPost from '../../../components/LocalizedPost.astro'

export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) =>
    data.locale !== data.sourceLocale && (!import.meta.env.PROD || !data.draft))
  return entries.map(entry => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
---

<LocalizedPost entry={entry} />
