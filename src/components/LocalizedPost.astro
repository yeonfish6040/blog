---
import path from 'node:path'
import { render, type CollectionEntry } from 'astro:content'
import License from '@components/misc/License.astro'
import Markdown from '@components/misc/Markdown.astro'
import I18nKey from '@i18n/i18nKey'
import { i18n } from '@i18n/translation'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { getDir, getLocalizedPostUrl, getPostUrlBySlug } from '@utils/url-utils'
import { Icon } from 'astro-icon/components'
import { licenseConfig } from 'src/config'
import PostMetadata from './PostMeta.astro'
import ImageWrapper from './misc/ImageWrapper.astro'
import Artalk from './Artalk.astro'
import { profileConfig } from '../config'
import { formatDateToYYYYMMDD } from '../utils/date-utils'

interface Props {
  entry: CollectionEntry<'posts'>
}

const { entry } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(entry)
const { locale, sourceLocale, slug, availableLocales } = entry.data
const postPageKey = getPostUrlBySlug(slug)
const likeCopyByLocale: Record<string, { prompt: string; label: string }> = {
  ko: { prompt: '글이 도움이 되었나요?', label: '좋아요' },
  en: { prompt: 'Did you find this post helpful?', label: 'Like' },
  ja: { prompt: 'この記事は役に立ちましたか？', label: 'いいね' },
  'zh-cn': { prompt: '这篇文章对你有帮助吗？', label: '点赞' },
  'zh-tw': { prompt: '這篇文章對你有幫助嗎？', label: '按讚' },
  es: { prompt: '¿Te ha resultado útil este artículo?', label: 'Me gusta' },
  th: { prompt: 'บทความนี้มีประโยชน์ไหม', label: 'ถูกใจ' },
}
const likeCopy = likeCopyByLocale[locale] || likeCopyByLocale.en
const localeNames: Record<string, string> = {
  ko: '한국어', en: 'English', ja: '日本語', 'zh-cn': '简体中文',
  'zh-tw': '繁體中文', es: 'Español', th: 'ไทย',
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description || entry.data.title,
  keywords: entry.data.tags,
  author: {
    '@type': 'Person',
    name: profileConfig.name,
    url: Astro.site,
  },
  datePublished: formatDateToYYYYMMDD(entry.data.published),
  inLanguage: locale,
  // TODO include cover image here
}
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <link slot="head" rel="canonical" href={new URL(getLocalizedPostUrl(slug, locale, sourceLocale), Astro.site)} />
    {availableLocales.map(language => (
      <link slot="head" rel="alternate" hreflang={language} href={new URL(getLocalizedPostUrl(slug, language, sourceLocale), Astro.site)} />
    ))}
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" data-post-locale={locale} class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.minutes} {" " + i18n(I18nKey.minutesCount)}</div>
                </div>
                {availableLocales.length > 1 && (
                    <div class="flex flex-row items-center ml-auto">
                        <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                            <Icon name="material-symbols:translate-rounded"></Icon>
                        </div>
                        <select
                            id="post-locale"
                            aria-label="Language"
                            class="text-sm bg-transparent border-none outline-none cursor-pointer transition
                                   text-black/30 dark:text-white/30 hover:text-[var(--primary)]
                                   focus-visible:outline-2 focus-visible:outline-[var(--primary)] rounded-md"
                            onchange="window.location.assign(this.value)"
                        >
                            {availableLocales.map(language => (
                                <option value={getLocalizedPostUrl(slug, language, sourceLocale)} selected={language === locale}>
                                    {localeNames[language] ? `${localeNames[language]} (${language})` : language}
                                </option>
                            ))}
                        </select>
                    </div>
                )}
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <div class="onload-animation mb-5 flex items-center gap-4 text-sm text-neutral-500 dark:text-neutral-400" aria-label="게시물 통계">
                <span class="inline-flex items-center gap-1"><Icon name="material-symbols:visibility-outline-rounded" class="text-base" /><span class="artalk-pv-count" data-page-key={postPageKey}>0</span></span>
                <span class="inline-flex items-center gap-1"><Icon name="material-symbols:mode-comment-outline-rounded" class="text-base" /><span class="artalk-comment-count" data-page-key={postPageKey}>0</span></span>
                <button type="button" class="post-vote-mini" data-vote-proxy aria-label={likeCopy.label} title={likeCopy.label}>
                    <Icon name="material-symbols:thumb-up-outline-rounded" class="text-base" />
                    <span class="tabular-nums" data-vote-proxy-count>0</span>
                </button>
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.data.sourceId))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            <!-- like -->
            <div class="onload-animation flex flex-col items-center gap-2 py-8 border-[var(--line-divider)] border-dashed border-t-[1px]">
                <div class="text-sm text-black/50 dark:text-white/50">{likeCopy.prompt}</div>
                <button id="artalk-page-vote-up" type="button" class="artalk-page-vote-up" aria-label={likeCopy.label}>
                    <Icon name="material-symbols:thumb-up-outline-rounded" class="artalk-page-vote-up-icon" />
                    <span class="artalk-page-vote-up-label">{likeCopy.label}</span>
                    <span id="artalk-page-vote-up-count" class="artalk-page-vote-up-count tabular-nums">0</span>
                </button>
            </div>

            <Artalk pageKey={postPageKey} />

            {licenseConfig.enable && <License title={entry.data.title} slug={slug} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>

</MainGridLayout>
