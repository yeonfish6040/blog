---
const server = 'https://comment.yeonfish.dev'
const pageKey = Astro.url.pathname
---

<link rel="stylesheet" href={`${server}/dist/Artalk.css`} />

<div class="artalk-page-vote-row mb-6 flex justify-center">
  <button type="button" class="artalk-page-vote-up text-black/75 dark:text-white/75" aria-label="이 글 좋아요">
    ❤️ 좋아요 <span class="artalk-page-vote-up-count">0</span>
  </button>
</div>

<div id="Comments" data-artalk-page-key={pageKey} class="mt-8"></div>

<style is:global>
  .artalk-page-vote-up {
    border: 1px solid var(--line-divider);
    border-radius: 9999px;
    padding: 0.65rem 1.25rem;
    background: var(--card-bg);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .artalk-page-vote-up:hover,
  .artalk-page-vote-up.active {
    color: var(--primary);
    border-color: var(--primary);
  }

  .artalk-page-vote-up:active {
    transform: scale(0.96);
  }
</style>
